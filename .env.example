# Pinlogy 環境変数の例
# このファイルをコピーして `.env` や CI secrets に設定してください。
# Flutter アプリ本体に秘密キーを埋め込まないでください。

# Supabase（公開してよいのは anon key のみ。service role はサーバー専用）
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# サーバー側（Edge Functions / 専用API）のみ
OPENAI_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_PLACES_API_KEY=
GEOCODING_API_KEY=

# 公開版のアプリ内経路表示（HTTPSのOSRM互換API。公開デモサーバーは使用しない）
# Flutterには --dart-define=ROUTING_API_BASE_URL=https://routes.example.com で渡す
ROUTING_API_BASE_URL=

# 地図表示用（Android / iOS で Bundle ID・署名制限を必ず設定）
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
